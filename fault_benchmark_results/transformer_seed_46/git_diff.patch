+        active = priorities > 0.0
+        loss_actor = torch.zeros((), device=h.device)
+        imagined_return = torch.zeros((), device=h.device)
+        updated = 0.0
+        if active.any():
+            h_active = h[active].detach()
+            z_active = z[active].detach()
